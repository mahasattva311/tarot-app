# ============================================================
# Tarot Reading App — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored; never commit real secrets.

# ------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------
# Three modes are supported. Uncomment exactly one block.

# --- Option A: Mock mode (no API key, no model required) ----
# Instant stub responses. Good for UI development and CI.
USE_MOCK_LLM=true

# --- Option B: Local Ollama (free, runs on your machine) ----
# Install: https://ollama.com
# Then:    ollama pull llama3.2
#          ollama serve
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2           # or mistral, gemma2, etc.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Option C: Anthropic API (production default) -----------
# LLM_PROVIDER=anthropic        # optional — anthropic is the default
# LLM_MODEL=claude-sonnet-4-20250514   # optional — this is the default
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Mock delay (only used when USE_MOCK_LLM=true)
# ------------------------------------------------------------
# Set to 0 in unit tests for instant responses;
# leave at default (~300ms) for realistic UI development.
# MOCK_DELAY_MS=300

# ------------------------------------------------------------
# Next.js
# ------------------------------------------------------------
# NEXTAUTH_SECRET=your-secret-here   # required if you add auth
# NEXTAUTH_URL=http://localhost:3000
